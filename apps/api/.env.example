PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Schema management (see README: "Banco de dados — migrations")
# TYPEORM_SYNCHRONIZE: auto-create/update schema from entities (dev only, never in prod)
# TYPEORM_MIGRATIONS_RUN: run pending migrations on API startup
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=false

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=dataform
DATABASE_PASSWORD=dataform
DATABASE_NAME=dataform
